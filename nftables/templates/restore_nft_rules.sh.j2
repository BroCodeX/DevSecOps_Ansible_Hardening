#!/bin/bash
# Managed by Ansible — do not edit manually.
set -uo pipefail

echo "=== Применяем правила nftables ==="

nft -f - << 'EOF'

flush ruleset

table inet filter {

    counter c_ssh_accept   {}
    counter c_stealth_drop {}
    counter c_null_drop    {}

    chain input {
        type filter hook input priority filter; policy drop;

        # Loopback
        iif "lo" accept

        # Установленные и связанные сессии
        ct state established,related accept

        # Невалидные пакеты
        ct state invalid drop

        # SSH
        tcp dport {{ nftables_ssh_port }} ct state new counter name c_ssh_accept accept
{% if nftables_web_enabled %}

        # HTTP/HTTPS
        tcp dport { 80, 443 } ct state new accept
{% endif %}

        # Аномальные TCP-флаги
        tcp flags & (fin|syn|rst|psh|ack|urg) == (fin|syn|rst|psh|ack|urg) \
            counter name c_stealth_drop log prefix "XMAS-SCAN: " drop
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0x0 \
            counter name c_null_drop log prefix "NULL-SCAN: " drop
        tcp flags & (fin|syn) == (fin|syn) \
            counter name c_stealth_drop log prefix "FIN-SYN-SCAN: " drop

        # ICMP ping
        ip protocol icmp icmp type { echo-request } accept

        # ICMPv6 (NDP обязателен для корректной работы IPv6)
        ip6 nexthdr icmpv6 icmpv6 type { echo-request, nd-neighbor-solicit,
                                         nd-neighbor-advert, nd-router-advert } accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }
}
EOF

echo "=== Сохраняем правила в {{ nftables_conf_path }} ==="
(
  echo "#!/usr/sbin/nft -f"
  echo ""
  echo "add table inet filter"
  echo "flush table inet filter"
  echo ""
  nft list table inet filter
) | tee {{ nftables_conf_path }}

echo "Готово!"
